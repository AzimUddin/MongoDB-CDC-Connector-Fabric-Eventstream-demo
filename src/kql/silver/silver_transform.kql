.create-or-alter function claims_silver_transform(){claims_raw_tbl|extend p=parse_json(tostring(payload))|extend a=replace_string(replace_string(tostring(p.after),\"\\"\",\"\"\"\"),\"\\\\",\"\"\")|extend doc=parse_json(a)|extend eventTimestamp=todatetime(tostring(doc.eventTimestamp))|project eventId=tostring(doc.eventId),claimId=tostring(doc.claimId),eventType=tostring(doc.eventType),eventTimestamp,claimStatus=tostring(doc.claimStatus),claimAmountDelta=todouble(doc.claimAmountDelta),region=tostring(doc.region),fraudScore=todouble(doc.fraudScore)}
